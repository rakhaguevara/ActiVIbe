{
  "name": "activivibe-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ActiVibe backend API service",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "dev:volunteer": "npm --prefix ../frontend run dev:volunteer",
    "dev:organizer": "npm --prefix ../frontend run dev:organizer",
    "dev:admin": "npm --prefix ../frontend run dev:admin",
    "start": "node src/server.js",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@google/genai": "^2.10.0",
    "@prisma/client": "^6.9.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "openai": "^6.45.0",
    "qrcode": "^1.5.4",
    "resend": "^6.17.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/qrcode": "^1.5.6",
    "nodemon": "^3.1.14",
    "prisma": "^6.9.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.9"
  }
}
