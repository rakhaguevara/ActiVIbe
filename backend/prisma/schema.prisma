generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String     @id @default(uuid())
  name       String
  email      String?    @unique
  phone      String?    @unique
  password   String
  role       Role       @default(VOLUNTEER)
  isVerified Boolean    @default(false)
  // FR-019: admin bisa aktifkan/nonaktifkan/suspend akun. SUSPENDED juga
  // memblokir login (lihat auth.service.js loginUser) — bukan cuma label.
  status     UserStatus @default(ACTIVE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  otpRequests   OtpRequest[]
  refreshTokens RefreshToken[]
  profile       Profile?
  userInterests UserInterest[]
  userSkills    UserSkill[]
  applications  Application[]
  skillProgress SkillProgress[]
  auditLogs     AuditLog[]
  eventViews    EventView[]
  bookmarks     EventBookmark[]

  // Organizer domain — dua relasi terpisah ke Event karena satu User bisa
  // jadi organizer sekaligus (di kesempatan lain) admin yang approve event.
  organizedEvents Event[]        @relation("EventOrganizer")
  approvedEvents  Event[]        @relation("EventApprovedBy")
  // Satu User bisa memiliki lebih dari satu Organization (lihat komentar di
  // model Organization) — lihat model Organization untuk alasan kenapa ini
  // model terpisah, bukan sekadar query User role=ORGANIZER.
  organizations   Organization[] @relation("OrganizationOwner")

  assignmentsMade      VolunteerAssignment[] @relation("AssignmentAssignedBy")
  organizerNotes       OrganizerNote[]       @relation("OrganizerNoteAuthor")
  communicationsSent   CommunicationLog[]    @relation("CommunicationSentBy")
  attendanceChecksMade AttendanceLog[]       @relation("AttendanceCheckedBy")
  eventFeedbacks       EventFeedback[]

  // Penutupan dini event (closedBeforeSchedule) — organizer bisa menerima
  // banyak peringatan, admin bisa mengirim banyak peringatan (lintas organizer).
  organizerWarningsReceived OrganizerWarning[] @relation("OrganizerWarningsReceived")
  organizerWarningsSent     OrganizerWarning[] @relation("OrganizerWarningsSent")

  // ActiVibe Plus (freemium/premium) — satu User (organizer ATAUPUN volunteer,
  // satu produk/harga sama utk kedua role, lihat subscriptions/plans.js) punya
  // maks satu baris Subscription. TIDAK ADA baris = FREE tier secara implisit
  // (lihat getUserTier di subscription.service.js) — sengaja tidak backfill
  // semua user lama dgn baris FREE eksplisit.
  subscription Subscription?
}

enum Role {
  VOLUNTEER
  ORGANIZER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

model OtpRequest {
  id         String     @id @default(uuid())
  userId     String
  code       String
  purpose    OtpPurpose @default(REGISTER)
  expiresAt  DateTime
  attempts   Int        @default(0)
  verifiedAt DateTime?
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum OtpPurpose {
  REGISTER
  ORGANIZATION_ACTIVATION
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// FR-004: profil pengguna (minat, keahlian) — lihat PRD v2.0 Section 7.1
model Profile {
  id           String        @id @default(uuid())
  userId       String        @unique
  bio          String?
  location     String?
  avatarUrl    String?
  // Ketersediaan volunteer — dikumpulkan lewat Conversational Onboarding Agent
  // (FR-023) tapi tidak ada di data dictionary PRD Section 7.1, ditambahkan
  // di sini supaya jawaban pertanyaan ketiga agent punya tempat disimpan.
  availability Availability?
  // Jurusan/pendidikan — metadata portofolio & filter organizer (FR-016),
  // sengaja TIDAK dipakai di Predictive Match Score (taksonomi jurusan
  // terlalu beragam untuk dipetakan otomatis ke tag event).
  education    String?
  // Motivasi volunteering, disederhanakan dari Volunteer Functions Inventory
  // (Clary et al.) — dicocokkan ke Event.motivationTag di Predictive Match
  // Score (FR-005), bobot 15%.
  motivation   Motivation?
  // CV terupload (FR-023 step 4, opsional) — file fisiknya di backend/uploads/cv/,
  // cvUrl cuma path publik (`/uploads/cv/...`), cvFileName nama asli buat ditampilkan di UI.
  cvUrl        String?
  cvFileName   String?
  // Jenis kelamin — dikumpulkan wajib lewat OnboardingModal (fitur "women
  // respect": info jumlah peserta perempuan & gender organizer di halaman
  // pendaftaran/card event, hanya tampil kalau volunteer yg login FEMALE).
  // Nullable di DB (pola sama motivation/availability) supaya user yang
  // sudah onboarding sebelum fitur ini ada tidak perlu backfill paksa —
  // mereka isi belakangan lewat SettingsPage.
  gender       Gender?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Availability {
  WEEKDAY
  WEEKEND
  BOTH
}

enum Gender {
  MALE
  FEMALE
}

enum Motivation {
  CAREER
  SOCIAL
  VALUES
  SKILL_GROWTH
}

model Interest {
  id       String @id @default(uuid())
  name     String @unique
  category String

  userInterests  UserInterest[]
  eventInterests EventInterest[]
}

model UserInterest {
  id         String   @id @default(uuid())
  userId     String
  interestId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@unique([userId, interestId])
  @@index([userId])
  @@index([interestId])
}

model Skill {
  id       String @id @default(uuid())
  name     String @unique
  category String

  userSkills      UserSkill[]
  eventSkills     EventSkill[]
  eventRoleSkills EventRoleSkill[]
  skillProgress   SkillProgress[]
}

model UserSkill {
  id        String   @id @default(uuid())
  userId    String
  skillId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
}

// FR-027: XP per skill, bertambah tiap event selesai berdasarkan skill tag
// event (lihat FR-017b/FR-048-049) — lihat PRD v2.0 Section 7.1 SkillProgress
model SkillProgress {
  id        String   @id @default(uuid())
  userId    String
  skillId   String
  xpTotal   Int      @default(0)
  level     Int      @default(1)
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
}

// FR-011/012: kegiatan volunteer — lihat PRD v2.0 Section 7.1 Event
model Event {
  id                String        @id @default(uuid())
  organizerId       String
  // Organisasi pemilik event (opsional/additive) — organizerId tetap dipakai
  // sebagai akun staff yang mengelola event ini (audit trail & approval flow
  // admin tidak berubah); organizationId khusus untuk fitur "Cari Organisasi"
  // volunteer, supaya tidak perlu migrasi besar mengubah semantik organizerId.
  organizationId    String?
  title             String
  description       String
  location          String
  quota             Int
  startDate         DateTime
  endDate           DateTime
  status            EventStatus   @default(DRAFT)
  // impact_metric_template dari PRD — nama & satuan metrik dampak event
  // (mis. "Jumlah bibit ditanam" / "bibit"), diisi organizer saat buat event
  // (FR-011) dan dipakai sbg saran nilai di close event flow (FR-017/FR-048).
  impactMetricLabel String
  impactMetricUnit  String?
  // Kategori kegiatan (mis. "Lingkungan", "Pendidikan") — bebas teks, PRD tidak
  // mengunci taksonomi tetap.
  category          String?
  // Sinyal tambahan utk Predictive Match Score (FR-005) — motivationTags
  // dicocokkan ke Profile.motivation (bobot 15%), dayType ke Profile.availability
  // (bobot 10%). Reuse enum Motivation/Availability yang sudah ada di Profile.
  motivationTags    Motivation[]
  dayType           Availability?
  approvedById      String?
  approvedAt        DateTime?
  // Catatan admin saat review (FR-020): alasan penolakan ATAU syarat approval
  // bersyarat — satu field, dua kegunaan, krn keduanya sama2 "catatan admin
  // soal event ini" dan tidak pernah terisi bersamaan.
  reviewNote        String?
  // Diisi saat event COMPLETED diarsipkan organizer (status jadi ARCHIVED) —
  // null selama belum diarsipkan, dikosongkan lagi kalau di-restore.
  archivedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // --- Enhancement: verifikasi organizer, dokumen pendukung, galeri, peta lokasi ---
  // Semua field di bawah nullable/berdefault supaya event lama tidak perlu backfill.
  eventMode EventMode @default(OFFLINE)
  // Link share Google Maps ATAU alamat lengkap/koordinat teks bebas — diparsing
  // jadi embed peta di frontend (lihat frontend/src/lib/mapsEmbed.ts), tanpa API key.
  mapLink   String?

  // Jenis badan hukum organizer saat event ini dibuat (snapshot per-event, bukan
  // di Organization, supaya tidak perlu halaman "Kelola Organisasi" terpisah).
  organizationEntityType OrganizationEntityType @default(INDIVIDU)
  // Centang "Event diselenggarakan atas nama instansi" — kalau true, Surat
  // Penugasan wajib diisi.
  onBehalfOfInstitution  Boolean                @default(false)

  // Dokumen pendukung verifikasi (FR baru) — wajib saat submit utk approval
  // (bukan saat draft), lihat validateCreateEvent. Hanya organizer & admin yang
  // bisa akses (tidak diekspos di serializePublicEvent).
  proposalDocUrl               String?
  proposalDocFileName          String?
  rundownDocUrl                String?
  rundownDocFileName           String?
  posterImageUrl               String?
  posterImageFileName          String?
  responsibilityLetterUrl      String?
  responsibilityLetterFileName String?
  // Wajib kalau eventMode = OFFLINE.
  locationPermitUrl            String?
  locationPermitFileName       String?
  // Transparansi sertifikat (ActiVibe Plus) — ACTIVIBE diset otomatis oleh
  // generateEventCertificates() saat organizer benar2 menerbitkan sertifikat
  // lewat ActiVibe (lihat gating tier di event.service.js), EXTERNAL diisi
  // manual oleh organizer (PATCH /events/:id/certificate-provider) kalau
  // sertifikat disediakan dari luar ActiVibe. Ditampilkan sbg badge di semua
  // permukaan event volunteer-facing supaya jelas dari awal.
  certificateProvider          CertificateProvider    @default(NONE)
  // Opsional — hanya kalau event bekerja sama dgn pihak lain.
  cooperationLetterUrl         String?
  cooperationLetterFileName    String?
  // Wajib kalau onBehalfOfInstitution = true.
  assignmentLetterUrl          String?
  assignmentLetterFileName     String?

  // Snapshot 11 checkbox pernyataan organizer (bukan kolom boolean terpisah)
  // supaya histori persis kalimat yang disetujui tetap terjaga walau redaksi
  // berubah nanti — lihat frontend/src/lib/organizerDeclarationItems.ts.
  declarationAcceptedAt DateTime?
  declarationChecklist  Json?

  // Business rule 1: PIC/pengurus penanggung jawab lapangan per event — dipakai
  // utk cek konflik saat organizer punya >1 event di tanggal yang sama (lihat
  // assertNoPicConflict di event.service.js). Dokumen pendukungnya reuse
  // responsibilityLetterUrl (tidak ada upload baru).
  picName           String?
  picContact        String?
  // Email PIC (baru, wajib bareng picContact sejak fitur Sub Organizer) —
  // dikirim ke volunteer di email tiket (lihat sendEventTicketEmail) supaya
  // ada kontak jelas kalau ada pertanyaan di lokasi.
  picEmail          String?
  // FK opsional ke SubOrganizer yang dipilih/dibuat organizer saat isi PIC —
  // picName/picContact/picEmail di atas tetap snapshot teks yang dipakai di
  // semua alur baca (conflict-check, email tiket, dst), field ini murni
  // bookkeeping "PIC ini diambil dari Sub Organizer mana" (SetNull kalau
  // SubOrganizer-nya dihapus, snapshot Event tidak ikut hilang).
  picSubOrganizerId String?

  // Ditandai saat organizer menutup pendaftaran (aksi terpisah dari closeEvent
  // penuh) — begitu terisi, applyToEvent() menolak pendaftaran baru.
  registrationClosedAt DateTime?

  // Diisi closeEvent() — closedBeforeSchedule true kalau closeEvent dipanggil
  // sebelum endDate lewat (penutupan dini, biasanya krn partisipasi rendah,
  // lihat LOW_PARTICIPATION_THRESHOLD di event.service.js & eventLifecycle.ts).
  // Dipakai admin utk panel review "Penutupan Dini" (admin.service.js
  // listPrematureClosures). participationRatePercentAtClose selalu diisi saat
  // close (bukan cuma saat closedBeforeSchedule) sbg konteks angka.
  closedAt                        DateTime?
  closedBeforeSchedule            Boolean    @default(false)
  participationRatePercentAtClose Int?

  organizer       User          @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  approvedBy      User?         @relation("EventApprovedBy", fields: [approvedById], references: [id])
  organization    Organization? @relation(fields: [organizationId], references: [id])
  picSubOrganizer SubOrganizer? @relation(fields: [picSubOrganizerId], references: [id], onDelete: SetNull)

  eventSkills       EventSkill[]
  eventInterests    EventInterest[]
  applications      Application[]
  eventRoles        EventRole[]
  requirements      EventRequirement[]
  communicationLogs CommunicationLog[]
  eventViews        EventView[]
  bookmarks         EventBookmark[]
  certificates      Certificate[]
  feedbacks         EventFeedback[]
  galleryImages     EventGalleryImage[]
  legalDocuments    EventLegalDocument[]
  closeReport       EventCloseReport?
  organizerWarnings OrganizerWarning[]

  @@index([organizerId])
  @@index([organizationId])
  @@index([status])
}

enum EventStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  ONGOING
  COMPLETED
  REJECTED
  ARCHIVED
}

enum EventMode {
  ONLINE
  OFFLINE
}

enum OrganizationEntityType {
  INDIVIDU
  PT
  CV
  YAYASAN
  ORGANISASI
}

enum OrganizationStatus {
  PENDING_VERIFICATION
  ACTIVE
}

enum LegalDocType {
  NIB
  AKTA
  SK_KEMENKUMHAM
  NPWP
}

enum CertificateProvider {
  NONE
  ACTIVIBE
  EXTERNAL
}

// Galeri dokumentasi event (1-6 foto) — sortOrder dipakai utk urutan drag & drop
// yg diatur organizer sebelum submit; gambar index 0 = thumbnail utama.
model EventGalleryImage {
  id        String   @id @default(uuid())
  eventId   String
  imageUrl  String
  fileName  String?
  sortOrder Int
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// Dokumen legal badan usaha organizer (NIB/Akta/SK Kemenkumham/NPWP) — snapshot
// per-event, minimal 1 wajib diupload kalau organizationEntityType != INDIVIDU.
model EventLegalDocument {
  id        String       @id @default(uuid())
  eventId   String
  docType   LegalDocType
  fileUrl   String
  fileName  String?
  createdAt DateTime     @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, docType])
  @@index([eventId])
}

model EventSkill {
  id      String @id @default(uuid())
  eventId String
  skillId String

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([eventId, skillId])
  @@index([eventId])
  @@index([skillId])
}

model EventInterest {
  id         String @id @default(uuid())
  eventId    String
  interestId String

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@unique([eventId, interestId])
  @@index([eventId])
  @@index([interestId])
}

// Domain "Organisasi" untuk fitur volunteer FindOrganizationPage — dibuat
// sebagai model penuh (bukan sekadar query User role=ORGANIZER) karena butuh
// field presentasi (logo, deskripsi, cause area) yang tidak masuk akal
// disimpan di User/Profile. Satu User bisa memiliki lebih dari satu
// Organization (ownerId TIDAK unique) — lewat dua jalur terpisah:
// (1) auto-provision saat organizer pertama kali membuat event (lihat
// ensureOrganizationForOwner di organization.service.js, langsung ACTIVE),
// atau (2) form pendaftaran self-service ("Daftarkan Organisasimu") yang
// butuh aktivasi email dulu (status PENDING_VERIFICATION -> ACTIVE lewat
// activationTokenHash, lihat registerOrganization/activateOrganization).
model Organization {
  id                       String             @id @default(uuid())
  ownerId                  String
  name                     String
  logoUrl                  String?
  shortProfile             String
  location                 String
  address                  String?
  website                  String?
  email                    String
  phone                    String
  causeAreas               String[]
  isVerified               Boolean            @default(false)
  status                   OrganizationStatus @default(PENDING_VERIFICATION)
  activationTokenHash      String?            @unique
  activationTokenExpiresAt DateTime?
  mission                  String?
  aboutUs                  String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  owner         User           @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  events        Event[]
  subOrganizers SubOrganizer[]

  @@index([ownerId])
}

// Kontak koordinator/PIC reusable ("Sub Organizer") — bukan akun User (orangnya
// tidak harus punya akun ActiVibe), cuma record kontak milik satu Organization
// supaya organizer tidak perlu ketik ulang nama+email+WA PIC tiap bikin event
// baru. Dipilih dari daftar ini saat isi PIC di CreateEventPage, tapi datanya
// di-snapshot ke Event.picName/picContact/picEmail saat event dibuat (lihat
// komentar picSubOrganizerId di model Event) — menghapus baris ini TIDAK
// mengubah data PIC di event yang sudah ada.
model SubOrganizer {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  email          String
  whatsapp       String
  title          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events       Event[]

  @@index([organizationId])
}

// Log setiap kali volunteer membuka detail event — sinyal perilaku "buka"
// utk Predictive Match Score behavioral boost (lihat recommendation.service.js
// getBehavioralAffinity). userId nullable + onDelete SetNull supaya baris log
// tetap ada (utk analitik agregat) walau akun user dihapus.
model EventView {
  id       String   @id @default(uuid())
  eventId  String
  userId   String?
  // Dari mana volunteer sampai ke halaman detail event ini — 'search',
  // 'recommendation', atau 'direct'. Bebas teks (bukan enum) krn cuma dipakai
  // utk breakdown traffic organizer, bukan logic bisnis yang butuh validasi ketat.
  source   String?
  viewedAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([userId])
}

// "Simpan/suka" event volunteer — sebelumnya cuma localStorage browser,
// dipindah ke backend supaya (a) persisten lintas device dan (b) jadi sinyal
// perilaku "suka" (bobot lebih tinggi dari EventView) utk behavioral boost.
model EventBookmark {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
  @@index([userId])
}

// FR-006: pendaftaran kegiatan volunteer
model Application {
  id           String            @id @default(uuid())
  userId       String
  eventId      String
  whatsapp     String
  motivation   String
  availability String[]
  status       ApplicationStatus @default(APPLIED)
  // Diisi organizer saat close event (FR-017/FR-048-049), bukan saat daftar
  attended     Boolean?
  impactValue  Float?
  // FR-007/FR-044: kode tiket unik (dgn QR) dikirim via email setelah
  // mendaftar — nullable krn Application lama (sebelum fitur ini) tidak
  // punya tiket. Dipakai checkInByTicketCode() utk check-in tanpa perlu
  // VolunteerAssignment (role/shift opsional per event).
  ticketCode   String?           @unique
  appliedAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  impactLog           ImpactLog?
  assignments         VolunteerAssignment[]
  organizerNotes      OrganizerNote[]
  requirementStatuses VolunteerRequirementStatus[]
  attendanceLogs      AttendanceLog[]
  certificate         Certificate?
  feedback            EventFeedback?

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

// FR-032 (pipeline volunteer) + FR-045/FR-048-049 (hasil attendance/close event)
enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WAITLISTED
  CHECKED_IN
  COMPLETED
  NO_SHOW
  CANCELLED_BY_ORGANIZER
  CANCELLED_BY_VOLUNTEER
  // Dibatalkan sistem (bukan organizer/volunteer) — volunteer ini sudah
  // ACCEPTED di event lain yang tanggalnya bentrok, lihat cascade di
  // application.service.js updateApplicationStatus/cancelOverlappingPendingApplications.
  CANCELLED_DATE_CONFLICT
}

// FR-009/FR-024: narasi & metrik dampak per volunteer per event
model ImpactLog {
  id            String   @id @default(uuid())
  applicationId String   @unique
  metricLabel   String
  value         Float
  unit          String
  aiHeadline    String?
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

// Sertifikat keikutsertaan — diterbitkan organizer per volunteer yang
// menyelesaikan event (Application.status COMPLETED), lewat aksi eksplisit
// "Generate Certificates" di CompletedEventsView (bukan otomatis saat close
// event, supaya organizer bisa cek data dulu sebelum menerbitkan).
model Certificate {
  id            String   @id @default(uuid())
  applicationId String   @unique
  eventId       String
  issuedAt      DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// Rating & komentar volunteer terhadap event yang sudah diikuti — hanya bisa
// diisi kalau Application.status volunteer tsb COMPLETED (lihat
// event.service.js submitFeedback), satu rating per keikutsertaan.
model EventFeedback {
  id            String   @id @default(uuid())
  applicationId String   @unique
  eventId       String
  userId        String
  rating        Int
  comment       String?
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// Business rule 1b: laporan penutupan kegiatan yang WAJIB diisi organizer saat
// closeEvent() — jadi arsip resmi ActiVibe DAN sumber data yang diarsipkan ke
// Impact Passport tiap volunteer (lihat passport.service.js). categoryMetrics
// sengaja Json fleksibel (bukan kolom per-kategori) krn field yang relevan
// beda-beda per Event.category (Lingkungan vs Seni & Budaya, dst) dan daftar
// kategori bisa berubah tanpa migrasi lagi. Bentuk per kategori (lihat
// CATEGORY_OPTIONS di CreateEventPage.tsx):
//   Lingkungan -> { treesPlanted?, hectaresImpacted?, peopleImpacted? }
//   Pendidikan/Kesehatan/Sosial -> { peopleImpacted?, breakdown?: { children?, adults?, elderly? } }
//   Seni & Budaya -> { successRatePercent? } (0-100)
//   Teknologi/Umum -> null
model EventCloseReport {
  id                     String   @id @default(uuid())
  eventId                String   @unique
  narrativeSummary       String
  volunteersPresentCount Int
  totalContributionHours Float
  photoUrls              String[]
  constraintsNotes       String?
  impactSummary          String?
  categoryMetrics        Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// Peringatan admin ke organizer krn menutup event sebelum jadwal (endDate)
// dgn partisipasi rendah (lihat Event.closedBeforeSchedule) — dikirim manual
// oleh admin dari panel "Penutupan Dini" (admin.service.js listPrematureClosures/
// sendOrganizerWarning), bukan otomatis/strike system. acknowledgedAt diisi
// saat organizer dismiss banner di Dashboard Home (organizerOverview.service.js
// acknowledgeOrganizerWarning) — banner di halaman event sendiri tidak
// dipengaruhi field ini, tetap tampil permanen sbg fakta historis.
model OrganizerWarning {
  id                       String    @id @default(cuid())
  eventId                  String
  organizerId              String
  adminId                  String
  message                  String
  participationRatePercent Int
  acknowledgedAt           DateTime?
  createdAt                DateTime  @default(now())

  event      Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organizer  User  @relation("OrganizerWarningsReceived", fields: [organizerId], references: [id])
  admin      User  @relation("OrganizerWarningsSent", fields: [adminId], references: [id])

  @@index([eventId])
  @@index([organizerId])
}

// ============================================
// ORGANIZER DOMAIN — PRD v2.1 Addendum Section O5.1
// Role & Shift Management (FR-029–031, FR-037)
// ============================================

model EventRole {
  id                String   @id @default(uuid())
  eventId           String
  roleName          String
  roleDescription   String?
  maxVolunteers     Int
  notesForVolunteer String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  event       Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  roleSkills  EventRoleSkill[]
  shifts      EventShift[]
  assignments VolunteerAssignment[]

  @@index([eventId])
}

model EventRoleSkill {
  id              String               @id @default(uuid())
  eventRoleId     String
  skillId         String
  requirementType SkillRequirementType @default(REQUIRED)

  eventRole EventRole @relation(fields: [eventRoleId], references: [id], onDelete: Cascade)
  skill     Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([eventRoleId, skillId])
  @@index([eventRoleId])
}

enum SkillRequirementType {
  REQUIRED
  OPTIONAL
}

model EventShift {
  id                 String    @id @default(uuid())
  eventRoleId        String
  shiftDate          DateTime
  startTime          DateTime
  endTime            DateTime
  quota              Int
  locationPoint      String?
  checkInWindowStart DateTime?
  checkInWindowEnd   DateTime?
  instructions       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  eventRole      EventRole             @relation(fields: [eventRoleId], references: [id], onDelete: Cascade)
  assignments    VolunteerAssignment[]
  attendanceLogs AttendanceLog[]

  @@index([eventRoleId])
}

// Menghubungkan volunteer accepted ke role dan shift tertentu (FR-037)
model VolunteerAssignment {
  id            String   @id @default(uuid())
  applicationId String
  eventRoleId   String
  eventShiftId  String
  assignedAt    DateTime @default(now())
  assignedById  String

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  eventRole   EventRole   @relation(fields: [eventRoleId], references: [id], onDelete: Cascade)
  eventShift  EventShift  @relation(fields: [eventShiftId], references: [id], onDelete: Cascade)
  assignedBy  User        @relation("AssignmentAssignedBy", fields: [assignedById], references: [id])

  @@unique([applicationId, eventShiftId])
  @@index([applicationId])
  @@index([eventRoleId])
  @@index([eventShiftId])
}

// Pre-Event Requirements (FR-039, FR-040)
model EventRequirement {
  id          String          @id @default(uuid())
  eventId     String
  title       String
  type        RequirementType
  description String?
  isMandatory Boolean         @default(true)
  createdAt   DateTime        @default(now())

  event    Event                        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  statuses VolunteerRequirementStatus[]

  @@index([eventId])
}

enum RequirementType {
  READ_ACKNOWLEDGE
  CHECKLIST
  UPLOAD_PROOF
}

model VolunteerRequirementStatus {
  id            String            @id @default(uuid())
  requirementId String
  applicationId String
  status        RequirementStatus @default(NOT_STARTED)
  completedAt   DateTime?

  requirement EventRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  application Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([requirementId, applicationId])
  @@index([applicationId])
}

enum RequirementStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// Catatan internal organizer per volunteer (FR-035)
model OrganizerNote {
  id            String   @id @default(uuid())
  organizerId   String
  applicationId String
  note          String
  createdAt     DateTime @default(now())

  organizer   User        @relation("OrganizerNoteAuthor", fields: [organizerId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

// Communication Center (FR-041–043)
model CommunicationLog {
  id              String   @id @default(uuid())
  eventId         String
  title           String
  message         String
  targetSegment   String
  // Tidak dibuat enum — PRD tidak mendaftar nilai channel yang baku
  deliveryChannel String
  sentAt          DateTime @default(now())
  sentById        String

  event  Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sentBy User  @relation("CommunicationSentBy", fields: [sentById], references: [id])

  @@index([eventId])
}

// Attendance / Check-in (FR-044–046)
model AttendanceLog {
  id            String        @id @default(uuid())
  applicationId String
  eventRoleId   String?
  eventShiftId  String?
  checkedInAt   DateTime      @default(now())
  method        CheckInMethod
  checkedById   String?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  eventShift  EventShift? @relation(fields: [eventShiftId], references: [id], onDelete: SetNull)
  checkedBy   User?       @relation("AttendanceCheckedBy", fields: [checkedById], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([eventShiftId])
}

enum CheckInMethod {
  QR
  MANUAL
}

// ============================================
// AUDIT — dipakai bareng oleh Admin (FR-022) & Organizer (FR-052);
// satu tabel, karena keduanya butuh "log aksi penting" dengan bentuk
// yang sama (aktor, aksi, target, waktu), bukan dua kebutuhan berbeda.
// ============================================
model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?
  action      String
  targetType  String?
  targetId    String?
  targetLabel String?
  metadata    Json?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([createdAt])
}

// ============================================
// ACTIVIBE PLUS — freemium/premium subscription
// Satu produk/harga sama utk akun ORGANIZER maupun VOLUNTEER, manfaatnya
// menyesuaikan role (lihat subscriptions/plans.js LIMITS). Pembayaran di-mock
// (tidak ada payment gateway asli) — checkout() langsung aktifkan tier &
// catat Transaction sbg simulasi; admin bisa juga override manual dari
// halaman Revenue (adminSetTier), keduanya lewat jalur Transaction yang sama.
// ============================================

enum SubscriptionTier {
  FREE
  PLUS_STARTER
  PLUS_PRO
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
}

enum TransactionStatus {
  SUCCESS
  FAILED
}

model Subscription {
  id               String             @id @default(uuid())
  userId           String             @unique
  tier             SubscriptionTier   @default(FREE)
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

// Riwayat "pembayaran" (mock) — juga sumber angka utk halaman Admin Revenue
// (getRevenueSummary/listSubscriptions di admin.service.js).
model Transaction {
  id             String            @id @default(uuid())
  subscriptionId String
  userId         String
  tier           SubscriptionTier
  amount         Int
  status         TransactionStatus @default(SUCCESS)
  // 'simulasi' = user checkout sendiri (mock instant-activate),
  // 'admin-manual' = admin override lewat halaman Revenue (amount 0).
  method         String
  paidAt         DateTime          @default(now())
  createdAt      DateTime          @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subscriptionId])
}
