# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/activivibe_db"

# JWT
JWT_ACCESS_SECRET=""       # generate: openssl rand -base64 32
JWT_REFRESH_SECRET=""      # generate: openssl rand -base64 32
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# OTP
OTP_EXPIRY_MINUTES=5
OTP_MAX_RESEND_ATTEMPTS=3

# Server
PORT=4000
NODE_ENV="development"

# CORS — wajib whitelist domain frontend (Vite dev server), jangan pakai wildcard di production.
# Bisa lebih dari satu origin dipisah koma (satu per portal: volunteer/organizer/admin).
FRONTEND_URL="http://localhost:5173,http://localhost:5174,http://localhost:5175"

# (Nanti) OTP delivery provider — isi saat integrasi SMS/email gateway
OTP_PROVIDER_API_KEY=""

# AI Personalisasi (FR-005) — semua opsional; kalau tidak ada key sama sekali,
# endpoint /recommendations tetap jalan pakai algoritma rule-based saja.
# AI_PROVIDER: claude | openai | gemini | auto (default auto = provider pertama
# yang key-nya terisi, urutan prioritas claude -> openai -> gemini)
AI_PROVIDER="auto"
ANTHROPIC_API_KEY=""   # https://platform.claude.com  (model default: claude-opus-4-8)
OPENAI_API_KEY=""      # https://platform.openai.com  (model default: gpt-4o-mini)
GEMINI_API_KEY=""      # https://aistudio.google.com  (model default: gemini-2.5-flash)
# Override model per provider kalau perlu:
# CLAUDE_MODEL=""
# OPENAI_MODEL=""
# GEMINI_MODEL=""
