node_modules/
.env
.env.test
*.log

# CV yang diupload user (lihat src/modules/profile/cv.upload.js) — file fisik
# jangan ikut commit, cuma path-nya (Profile.cvUrl) yang tersimpan di DB.
uploads/*
!uploads/cv/
uploads/cv/*
!uploads/cv/.gitkeep

# Template sertifikat default (seed.js) ikut di-commit supaya fresh clone
# tetap punya minimal 1 CertificateTemplate aktif — beda dari template lain
# yang admin upload belakangan lewat halaman Certificate Templates (itu tetap
# gitignored spt upload lainnya).
!uploads/certificate-templates/
uploads/certificate-templates/*
!uploads/certificate-templates/default-template.pdf
