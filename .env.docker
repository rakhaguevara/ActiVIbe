# ============================================================
# .env.docker — Template environment variables untuk Docker
# Salin file ini menjadi .env di root project, lalu isi nilainya.
#
#   cp .env.docker .env
#
# JANGAN commit file .env ke git!
# ============================================================

# ─── PostgreSQL ─────────────────────────────────────────────
# Password untuk user database (bebas, asal kuat)
POSTGRES_PASSWORD=GantiDenganPasswordKuat123!

# ─── JWT Secrets ─────────────────────────────────────────────
# Generate dengan: openssl rand -base64 32
JWT_ACCESS_SECRET=ganti_dengan_secret_access_token_yang_kuat
JWT_REFRESH_SECRET=ganti_dengan_secret_refresh_token_yang_kuat

# Durasi token (opsional, ada default)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS — Whitelist domain frontend ────────────────────────
# Isi dengan domain/IP publik server + port portal
# Contoh deployment lokal:
FRONTEND_URL=http://localhost:5173,http://localhost:5175,http://localhost:5176
# Contoh deployment dengan domain:
# FRONTEND_URL=https://activibe.yourdomain.com,https://admin.yourdomain.com,https://organizer.yourdomain.com

# ─── URL portal volunteer (untuk link email set-password orgs) ─
VOLUNTEER_PORTAL_URL=http://localhost:5173
# Produksi: VOLUNTEER_PORTAL_URL=https://activibe.yourdomain.com

# ─── Vite API URL (build-time, untuk frontend container) ─────
# Bila pakai Nginx proxy di frontend, bisa isi dengan URL backend internal
# Tapi karena Nginx proxy dipakai, ini dipakai saat build untuk fallback
VITE_API_URL=http://localhost:4000
# Produksi: VITE_API_URL=https://api.yourdomain.com

# ─── Email (Resend) ──────────────────────────────────────────
# Kosongkan = OTP/link dikirim ke console log (cukup untuk dev/demo)
# Isi untuk production agar email OTP benar-benar terkirim
RESEND_API_KEY=
RESEND_FROM_EMAIL=ActiVibe <no-reply@activibe.id>

# ─── AI Providers (semua opsional) ───────────────────────────
# Tanpa API key sama sekali, sistem pakai rule-based fallback otomatis.
# AI_PROVIDER: auto | claude | openai | gemini
AI_PROVIDER=auto

ANTHROPIC_API_KEY=
CLAUDE_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=

# ─── OTP Settings ────────────────────────────────────────────
OTP_EXPIRY_MINUTES=5
OTP_MAX_RESEND_ATTEMPTS=3
